FROM node:22-bookworm-slim AS build

WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/moonraker-adapter/package.json packages/moonraker-adapter/package.json
COPY packages/octoprint-adapter/package.json packages/octoprint-adapter/package.json
COPY packages/prusalink-adapter/package.json packages/prusalink-adapter/package.json
COPY packages/anycubic-adapter/package.json packages/anycubic-adapter/package.json
COPY packages/creality-adapter/package.json packages/creality-adapter/package.json
RUN pnpm install --frozen-lockfile --filter @conceito/api...

COPY apps/api apps/api
COPY packages packages
RUN pnpm --filter @conceito/core build \
  && pnpm --filter @conceito/moonraker-adapter build \
  && pnpm --filter @conceito/octoprint-adapter build \
  && pnpm --filter @conceito/prusalink-adapter build \
  && pnpm --filter @conceito/anycubic-adapter build \
  && pnpm --filter @conceito/creality-adapter build \
  && pnpm --filter @conceito/api build

FROM node:22-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production
RUN apt-get update \
  && apt-get install -y --no-install-recommends poppler-utils tesseract-ocr tesseract-ocr-por imagemagick \
  && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/api ./apps/api
COPY --from=build /app/packages ./packages

EXPOSE 3001
CMD ["node", "apps/api/dist/server.js"]
