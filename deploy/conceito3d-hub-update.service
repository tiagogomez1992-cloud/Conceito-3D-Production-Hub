[Unit]
Description=Atualização segura do Conceito 3D Production Hub
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/c3d-hub-update
StandardOutput=append:/var/log/conceito3d-hub-update.log
StandardError=append:/var/log/conceito3d-hub-update.log
