# Copiar para .env no servidor e definir credenciais fortes.
HUB_AUTH_USER=administrador
HUB_AUTH_PASSWORD=altere-esta-password-por-uma-frase-secreta-longa
# Painel físico ESP32: gere um valor aleatório, por exemplo com
# `openssl rand -hex 32`. Este token só permite consultar o resumo do painel.
DISPLAY_API_TOKEN=cole-aqui-um-token-aleatorio-longo
# O ESP32 usa o IP local do HP, não o IP Tailscale.
SERVER_LOCAL_IP=192.168.1.10
SERVER_TAILSCALE_IP=100.74.119.75
# Deixa vazio para usar /srv/containers/backups no HP.
BACKUP_DIR=
# IA: ollama (local, recomendado), openai, auto ou local (só OCR).
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b
# Opcional: ativa ChatGPT apenas se AI_PROVIDER=openai ou auto.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
